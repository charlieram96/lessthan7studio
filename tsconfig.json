{
  "extends": "astro/tsconfigs/strict",
  "include": [
    ".astro/types.d.ts",
    "**/*"
  ],
  "exclude": [
    "dist",
    "dist-artifact",
    "artifact",
    "node_modules"
  ],
  "compilerOptions": {
    "paths": {
      "~/*": [
        "./src/*"
      ]
    },
    "verbatimModuleSyntax": true
  }
}
