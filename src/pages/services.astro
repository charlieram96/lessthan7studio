---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import { PILLARS, PROCESS } from '../data/services';
import { PROJECTS, img } from '../data/projects';
import { breadcrumbs, services, webPage } from '../lib/schema';

const title = 'Services: web design, development and SEO in Miami | lessthan7';
const description =
  'Website design, hand-built development and technical SEO from a Miami studio. Fast, accessible, bilingual-ready websites with Core Web Vitals in the green.';

const serviceForPillar: Record<string, string> = {
  design: 'Web design',
  development: 'Development',
  search: 'SEO',
};

const engagements = [
  {
    name: 'New website',
    body: 'Strategy, design, build and launch for a business that needs its first real site, or a fresh start.',
    time: 'Typically 6–10 weeks',
  },
  {
    name: 'Redesign',
    body: 'A faster, clearer version of the site you have, with redirects that protect the rankings you’ve earned.',
    time: 'Typically 6–10 weeks',
  },
  {
    name: 'SEO and performance',
    body: 'Audits, Core Web Vitals fixes, schema, local SEO and content plans for sites that need to be found.',
    time: 'One-off or monthly',
  },
  {
    name: 'Landing pages',
    body: 'Campaign and launch pages that load instantly and are built to convert paid traffic.',
    time: 'Typically 1–3 weeks',
  },
];

const faqs = [
  {
    q: 'How long does a website take?',
    a: 'Most projects take six to ten weeks from the first call to launch. Landing pages can be ready in one to three weeks. You get a schedule with dates in the proposal.',
  },
  {
    q: 'Do you only work with Miami businesses?',
    a: 'No. We are based in Miami and know South Florida well, but we work with businesses anywhere. Everything runs smoothly over video calls and shared links.',
  },
  {
    q: 'Can I update the site myself?',
    a: 'Yes. When you need to edit content regularly, we connect a content management system and show you how to use it. Simple sites can stay code-only and cost less to run.',
  },
  {
    q: 'Do you build bilingual websites?',
    a: 'Yes. Several of our clients serve customers in English and Spanish. We set up translated pages with the right hreflang tags so Google shows each visitor the right language.',
  },
  {
    q: 'Is SEO included?',
    a: 'Technical SEO is part of every build: fast pages, clean structure, metadata, structured data, sitemaps and Search Console setup. Ongoing SEO, like content and local search work, is available separately.',
  },
  {
    q: 'What do you build with?',
    a: 'Usually Astro or Next.js, hosted on Netlify or Vercel. We choose the stack for each project based on what it needs to do and who will maintain it.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Base
  title={title}
  description={description}
  path="/services/"
  image="/og/services.png"
  jsonLd={[
    webPage({ path: '/services/', name: title, description }),
    services(PILLARS.map((p) => ({ name: p.schemaName, description: p.summary }))),
    faqSchema,
    breadcrumbs([
      { name: 'Home', path: '/' },
      { name: 'Services', path: '/services/' },
    ]),
  ]}
>
  <PageHero
    eyebrow="Services"
    lines={['Design.', 'Development.', 'Search.']}
    lede="Three disciplines that most agencies split between three teams. We keep them together, because a first impression depends on all of them at once."
  />

  {
    PILLARS.map((p, i) => {
      const examples = PROJECTS.filter((pr) => pr.services.includes(serviceForPillar[p.id] as never)).slice(0, 3);
      return (
        <section class:list={['svc-block', { paper: i % 2 === 0 }]} id={p.id} aria-labelledby={`${p.id}-title`}>
          <div class="svc-block__wrap">
            <div class="svc-block__head">
              <p class="svc-block__name">{p.name}</p>
              <h2 id={`${p.id}-title`} class="svc-block__title">
                {p.headline}
              </h2>
            </div>
            <div class="svc-block__body">
              <p class="svc-block__summary" data-reveal>
                {p.summary}
              </p>
              <ul class="svc-block__caps" role="list">
                {p.capabilities.map((c) => (
                  <li data-reveal>{c}</li>
                ))}
              </ul>
            </div>
            {examples.length > 0 && (
              <div class="svc-block__examples">
                <p class="svc-block__examples-label">In practice</p>
                <ul role="list">
                  {examples.map((pr) => (
                    <li>
                      <a href={`/work/${pr.slug}/`} class="mini" data-cursor="View">
                        <span class="mini__img">
                          <img src={img(pr.slug, 'hero-960.webp')} alt="" width="960" height="600" loading="lazy" decoding="async" />
                        </span>
                        <span class="mini__name">{pr.name}</span>
                        <span class="mini__meta">{pr.industry}</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </div>
        </section>
      );
    })
  }

  <section class="engage" aria-labelledby="engage-title">
    <div class="engage__wrap">
      <h2 id="engage-title" class="engage__title display">
        <span class="line-mask"><span data-split-line>Ways to work</span></span>
        <span class="line-mask"><span data-split-line>together.</span></span>
      </h2>
      <ul class="engage__grid" role="list">
        {
          engagements.map((e) => (
            <li class="engage__item" data-reveal>
              <h3>{e.name}</h3>
              <p>{e.body}</p>
              <p class="engage__time">{e.time}</p>
            </li>
          ))
        }
      </ul>
      <div class="engage__steps" data-reveal>
        <p class="eyebrow">Every project, six steps</p>
        <ol role="list">
          {PROCESS.map((s) => <li>{s.name}</li>)}
        </ol>
      </div>
    </div>
  </section>

  <section class="faq paper" aria-labelledby="faq-title">
    <div class="faq__wrap">
      <h2 id="faq-title" class="faq__title display">Questions people ask first.</h2>
      <div class="faq__list">
        {
          faqs.map((f) => (
            <details class="faq__item">
              <summary>
                <span>{f.q}</span>
                <span class="faq__icon" aria-hidden="true" />
              </summary>
              <p>{f.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>
</Base>

<style>
  .svc-block {
    padding-block: var(--space-2xl);
    scroll-margin-top: var(--header-h);
  }

  .svc-block__wrap {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: var(--space-l) var(--space-xl);
    max-width: var(--max);
    margin-inline: auto;
    padding-left: var(--gutter);
    padding-right: var(--gutter-r);
  }

  .svc-block__name {
    font-size: var(--step--1);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent-text);
  }

  .svc-block__title {
    margin-top: 0.8rem;
    font-size: var(--step-4);
    max-width: 13ch;
  }

  .svc-block__summary {
    font-size: var(--step-1);
    line-height: 1.5;
    color: var(--text-mute);
    max-width: 48ch;
  }

  .svc-block__caps {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin-top: var(--space-m);
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line-strong);
  }

  .svc-block__caps li {
    padding: 0.95rem 0;
    border-bottom: 1px solid var(--line);
    font-weight: 500;
  }

  .svc-block__caps li:nth-child(odd) {
    padding-right: 1rem;
  }

  .svc-block__examples {
    grid-column: 1 / -1;
    margin-top: var(--space-m);
  }

  .svc-block__examples-label {
    margin-bottom: 1rem;
    font-size: var(--step--1);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--text-faint);
  }

  .svc-block__examples ul {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: var(--space-s);
    padding: 0;
    list-style: none;
  }

  .mini {
    display: grid;
    gap: 0.4rem;
  }

  .mini__img {
    display: block;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--surface);
    box-shadow: 0 0 0 1px var(--line);
  }

  .mini__img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    transition: transform 0.9s var(--ease-out);
  }

  .mini:hover .mini__img img {
    transform: scale(1.05);
  }

  .mini__name {
    margin-top: 0.4rem;
    font-family: var(--font-display);
    font-weight: 750;
    font-size: var(--step-1);
    letter-spacing: -0.03em;
  }

  .mini__meta {
    font-size: var(--step--1);
    color: var(--text-mute);
  }

  .engage {
    padding-block: var(--space-3xl);
  }

  .engage__wrap {
    max-width: var(--max);
    margin-inline: auto;
    padding-left: var(--gutter);
    padding-right: var(--gutter-r);
  }

  .engage__title {
    font-size: var(--step-5);
    margin-bottom: var(--space-xl);
  }

  .engage__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--space-m);
    padding: 0;
    list-style: none;
  }

  .engage__item {
    display: grid;
    align-content: start;
    gap: 0.7rem;
    padding-top: var(--space-s);
    border-top: 2px solid var(--sun-2);
  }

  .engage__item h3 {
    font-size: var(--step-2);
    letter-spacing: -0.03em;
  }

  .engage__item p {
    color: var(--text-mute);
  }

  .engage__time {
    font-size: var(--step--1);
    font-weight: 600;
    color: var(--text) !important;
  }

  .engage__steps {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 1rem 2rem;
    margin-top: var(--space-2xl);
    padding-top: var(--space-m);
    border-top: 1px solid var(--line);
  }

  .engage__steps ol {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem 1.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
    counter-reset: step;
    font-family: var(--font-display);
    font-weight: 750;
    font-size: var(--step-2);
    letter-spacing: -0.03em;
  }

  .engage__steps li {
    counter-increment: step;
  }

  .engage__steps li::before {
    content: counter(step);
    margin-right: 0.45rem;
    font-family: var(--font-body);
    font-size: var(--step--1);
    font-weight: 700;
    color: var(--sun-2);
    vertical-align: super;
  }

  .faq {
    padding-block: var(--space-3xl);
  }

  .faq__wrap {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: var(--space-xl);
    max-width: var(--max);
    margin-inline: auto;
    padding-left: var(--gutter);
    padding-right: var(--gutter-r);
  }

  .faq__title {
    font-size: var(--step-4);
    max-width: 10ch;
  }

  .faq__list {
    border-top: 1px solid var(--line-strong);
  }

  .faq__item {
    border-bottom: 1px solid var(--line-strong);
  }

  .faq__item summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    padding: 1.4rem 0;
    cursor: pointer;
    list-style: none;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: var(--step-1);
    letter-spacing: -0.02em;
  }

  .faq__item summary::-webkit-details-marker {
    display: none;
  }

  .faq__icon {
    position: relative;
    flex: none;
    width: 18px;
    height: 18px;
  }

  .faq__icon::before,
  .faq__icon::after {
    content: '';
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    height: 2px;
    margin-top: -1px;
    background: currentColor;
    transition: transform 0.4s var(--ease-out);
  }

  .faq__icon::after {
    transform: rotate(90deg);
  }

  .faq__item[open] .faq__icon::after {
    transform: rotate(0deg);
  }

  .faq__item p {
    padding-bottom: 1.5rem;
    max-width: 60ch;
    color: var(--text-mute);
  }

  @media (max-width: 1000px) {
    .engage__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 900px) {
    .svc-block__wrap,
    .faq__wrap {
      grid-template-columns: 1fr;
    }

    .svc-block__examples ul {
      grid-template-columns: 1fr 1fr;
    }
  }

  @media (max-width: 560px) {
    .engage__grid,
    .svc-block__caps,
    .svc-block__examples ul {
      grid-template-columns: 1fr;
    }
  }
</style>
