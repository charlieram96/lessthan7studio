---
import { PROJECTS, countWord, img } from '../../data/projects';

const featured = PROJECTS.filter((p) => p.featured !== false);
---

<section class="reel" data-reel aria-labelledby="reel-title">
  <div class="reel__inner">
    <header class="reel__head">
      <div class="reel__heading">
        <p class="eyebrow">Selected work</p>
        <h2 id="reel-title" class="reel__title display">
          <span class="line-mask"><span data-split-line>Recent first</span></span>
          <span class="line-mask"><span data-split-line>impressions.</span></span>
        </h2>
      </div>
      <p class="reel__intro" data-reveal>
        {countWord(featured.length)} websites for law firms, clinics, villas, academies, artists and the businesses that
        keep Miami running. Each one built to load fast, read clearly and rank.
      </p>
    </header>

    <div class="reel__viewport" data-reel-viewport>
      <ul class="reel__track" data-reel-track role="list">
        {
          featured.map((p, i) => (
            <li class="reel__item" data-reel-item style={`--accent:${p.accent}`}>
              <a href={`/work/${p.slug}/`} class="card" data-cursor="View" aria-label={`${p.name}: case study`}>
                <div class="card__media">
                  <div class="card__chrome" aria-hidden="true">
                    <i />
                    <i />
                    <i />
                    <span class="card__url">{p.displayUrl}</span>
                  </div>
                  <div class="card__shot">
                    <img
                      src={img(p.slug, 'hero-960.webp')}
                      srcset={`${img(p.slug, 'hero-960.webp')} 960w, ${img(p.slug, 'hero.webp')} 1920w`}
                      sizes="(max-width: 900px) 84vw, 46vw"
                      width="1920"
                      height="1200"
                      alt={`Homepage of the ${p.name} website`}
                      loading={i < 2 ? 'eager' : 'lazy'}
                      decoding="async"
                      data-reel-img
                    />
                  </div>
                </div>
                <div class="card__meta">
                  <h3 class="card__name">{p.name}</h3>
                  <p class="card__industry">
                    {p.industry} <span aria-hidden="true">·</span> {p.location}
                  </p>
                </div>
              </a>
            </li>
          ))
        }
        <li class="reel__item reel__item--end">
          <a href="/work/" class="reel__all" data-cursor="All">
            <span class="reel__all-label">See every project</span>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 12h15m-6-6 6 6-6 6" fill="none" stroke="currentColor" stroke-width="1.5"></path></svg>
          </a>
        </li>
      </ul>
    </div>

    <div class="reel__progress" aria-hidden="true"><span data-reel-progress></span></div>
  </div>
</section>

<style>
  .reel {
    position: relative;
    background: var(--ink);
    overflow: hidden;
  }

  .reel__inner {
    display: grid;
    /* Keep the column at viewport width; the track overflows it on purpose. */
    grid-template-columns: minmax(0, 1fr);
    align-content: center;
    gap: var(--space-l);
    padding-block: var(--space-2xl) var(--space-xl);
  }

  .reel__head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 26rem);
    align-items: end;
    gap: var(--space-m) var(--space-xl);
    width: 100%;
    max-width: var(--max);
    margin-inline: auto;
    padding-left: var(--gutter);
    padding-right: var(--gutter-r);
  }

  .reel__title {
    margin-top: var(--space-xs);
    font-size: var(--step-5);
  }

  .reel__intro {
    color: var(--text-mute);
    max-width: 38ch;
  }

  .reel__viewport {
    min-width: 0;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }

  .reel__viewport::-webkit-scrollbar {
    display: none;
  }

  .reel__track {
    display: flex;
    gap: clamp(16px, 2.4vw, 40px);
    width: max-content;
    margin: 0;
    padding: 0 var(--gutter-r) 0 var(--gutter);
    list-style: none;
  }

  .reel__item {
    flex: none;
    width: clamp(290px, 46vw, 860px);
    scroll-snap-align: start;
  }

  .card {
    display: grid;
    gap: 1.1rem;
    will-change: transform;
  }

  .card__media {
    position: relative;
    overflow: hidden;
    background: var(--ink-raised);
    box-shadow:
      0 0 0 1px rgb(243 241 247 / 0.08),
      0 40px 80px -40px rgb(0 0 0 / 0.8);
    transform: translateZ(0);
  }

  .card__chrome {
    display: flex;
    align-items: center;
    gap: 6px;
    height: 30px;
    padding: 0 12px;
    background: #1c1826;
    border-bottom: 1px solid rgb(243 241 247 / 0.06);
  }

  .card__chrome i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: rgb(243 241 247 / 0.16);
  }

  .card__url {
    margin-left: 10px;
    font-size: 0.72rem;
    color: var(--text-faint);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .card__shot {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
  }

  .card__shot img {
    position: absolute;
    inset: 0 -6%;
    width: 112%;
    max-width: none;
    height: 100%;
    object-fit: cover;
    object-position: top center;
    transition: transform 1.1s var(--ease-out);
  }

  .card:hover .card__shot img,
  .card:focus-visible .card__shot img {
    transform: scale(1.04);
  }

  .card__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 55%, color-mix(in srgb, var(--accent) 35%, transparent));
    opacity: 0;
    transition: opacity 0.6s ease;
    pointer-events: none;
  }

  .card:hover .card__media::after {
    opacity: 1;
  }

  .card__meta {
    display: grid;
    gap: 0.35rem;
  }

  .card__name {
    font-size: var(--step-3);
    letter-spacing: -0.035em;
    line-height: 1;
  }

  .card__industry {
    color: var(--text-mute);
    font-size: var(--step--1);
  }

  .reel__item--end {
    width: clamp(240px, 28vw, 440px);
    display: grid;
  }

  .reel__all {
    display: grid;
    place-content: center;
    justify-items: center;
    gap: 1rem;
    aspect-ratio: 1 / 1.05;
    align-self: start;
    border: 1px solid var(--line-strong);
    font-family: var(--font-display);
    font-weight: 750;
    font-stretch: 110%;
    font-size: var(--step-2);
    letter-spacing: -0.03em;
    text-align: center;
    transition:
      background-color 0.5s ease,
      color 0.5s ease;
  }

  .reel__all svg {
    width: 2.6rem;
    transition: transform 0.6s var(--ease-out);
  }

  .reel__all:hover,
  .reel__all:focus-visible {
    background: var(--paper);
    color: var(--ink);
  }

  .reel__all:hover svg {
    transform: translateX(0.5rem);
  }

  .reel__progress {
    width: calc(100% - var(--gutter) - var(--gutter-r));
    max-width: calc(var(--max) - 112px);
    height: 1px;
    margin-inline: auto;
    background: var(--line);
    overflow: hidden;
  }

  .reel__progress span {
    display: block;
    height: 100%;
    background: var(--sun);
    transform-origin: 0 50%;
    transform: scaleX(0);
  }

  /* Pinned mode */
  .reel.is-pinned .reel__inner {
    height: 100vh;
    height: 100lvh;
    padding-block: calc(var(--header-h) + 1rem) var(--space-l);
  }

  .reel.is-pinned .reel__viewport {
    overflow: visible;
    scroll-snap-type: none;
  }

  @media (max-width: 900px) {
    .reel__head {
      grid-template-columns: 1fr;
    }

    .reel__item {
      width: 84vw;
    }

    .reel.is-pinned .reel__inner {
      align-content: space-evenly;
    }
  }

  @media (max-height: 760px) and (min-width: 901px) {
    .reel__item {
      width: clamp(290px, 40vw, 700px);
    }

    .reel__intro {
      display: none;
    }
  }
</style>
