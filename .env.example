# Required for the hidden /lab revamp generator (Netlify → Site configuration → Environment variables)
ANTHROPIC_API_KEY=
# Access code staff type into /lab before generating. The lab stays locked until this is set.
LAB_ACCESS_CODE=
# Optional: max reports per day (default 20)
LAB_DAILY_LIMIT=20
# Optional: Google PageSpeed Insights API key — adds real Lighthouse scores + a screenshot of the prospect's current site to each report
PAGESPEED_API_KEY=
